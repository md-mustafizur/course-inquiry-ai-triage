      "parameters": {
        "jsCode": "const original = $('Mask PII').first().json;\nconst raw = $input.first().json.content[0].text;\n\n// Strip markdown code fences if present\nconst cleaned = raw.replace(/```json\\s*/g, '').replace(/```\\s*/g, '').trim();\n\nlet parsed;\nlet isValid = true;\nlet errorReason = '';\n\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  isValid = false;\n  errorReason = 'JSON parse failed: ' + e.message;\n  parsed = {};\n}\n\nif (isValid) {\n  const allowedIntents = ['price', 'schedule', 'job_placement', 'complaint', 'spam', 'other'];\n  const allowedLanguages = ['bn', 'en', 'mixed'];\n\n  if (!allowedIntents.includes(parsed.intent)) {\n    isValid = false; errorReason = 'invalid intent';\n  } else if (typeof parsed.lead_score !== 'number' || parsed.lead_score < 1 || parsed.lead_score > 10) {\n    isValid = false; errorReason = 'invalid lead_score';\n  } else if (!allowedLanguages.includes(parsed.language)) {\n    isValid = false; errorReason = 'invalid language';\n  } else if (typeof parsed.summary !== 'string' || !parsed.summary) {\n    isValid = false; errorReason = 'missing summary';\n  } else if (typeof parsed.suggested_reply !== 'string' || !parsed.suggested_reply) {\n    isValid = false; errorReason = 'missing suggested_reply';\n  } else if (typeof parsed.needs_human !== 'boolean') {\n    isValid = false; errorReason = 'invalid needs_human';\n  }\n}\n\nreturn [{\n  json: {\n    ...original,\n    is_valid: isValid,\n    error_reason: errorReason,\n    intent: parsed.intent,\n    lead_score: parsed.lead_score,\n    language: parsed.language,\n    summary: parsed.summary,\n    suggested_reply: parsed.suggested_reply,\n    needs_human: parsed.needs_human\n  }\n}];"

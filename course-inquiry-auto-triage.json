    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst inputSummary = `${item.body?.name || 'N/A'} | ${item.body?.course_interest || 'N/A'} | ${item.body?.message || 'N/A'}`;\n\nconst claudeOutput = JSON.stringify({\n  intent: item.intent,\n  lead_score: item.lead_score,\n  language: item.language,\n  summary: item.summary,\n  suggested_reply: item.suggested_reply,\n  needs_human: item.needs_human\n});\n\n// Rough token estimate: ~4 characters per token (English/mixed approx)\nconst inputChars = (item.body?.message || '').length + 300; // +300 for system prompt overhead estimate\nconst outputChars = claudeOutput.length;\nconst estimatedTokens = Math.ceil((inputChars + outputChars) / 4);\nconst estimatedCostUSD = (estimatedTokens / 1000000 * 0.8).toFixed(6); // Haiku-class approx rate, adjust per actual pricing\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    route: item.route || 'unknown',\n    input_summary: inputSummary,\n    claude_output: claudeOutput,\n    estimated_token_cost: estimatedCostUSD\n  }\n}];"
      },
